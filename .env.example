# IANUA Agent Trust Broker — documented configuration keys (AGENTS.md §4).
# Copy to .env for local use; NEVER commit a real .env (gitignored, CI-blocked).

# Path to the durable, hash-chained JSONL audit log. Shared by the broker /
# gateway (writer) and the `atb` operator CLI (reader/resolver). One writer
# at a time by design. Unset: the example gateway runs with an in-memory chain.
ATB_AUDIT_CHAIN=

# Hex-encoded HMAC signing key (>= 32 bytes / 64 hex chars) for the identity
# authority. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Unset: the example gateway generates an ephemeral per-process key, so minted
# identities die with the process. Never hard-code; never log.
ATB_SIGNING_KEY=

# --- ATB-04 response screening & quarantine ---------------------------------

# Directory for quarantined (withheld) tool-response payloads. REQUIRED when
# ATB_AUDIT_CHAIN is set — a durable chain needs a durable quarantine. Must
# lie outside workspace/. Created 0700; blobs 0600, content-addressed by
# sha256. Sensitive by default: never commit; local to the lab host.
# Unset (demo mode, in-memory chain): an in-memory store is used.
ATB_QUARANTINE_DIR=

# Screening scan-cost bound in bytes (default 1048576 = 1 MiB). Responses
# larger than this (up to the blob cap) are quarantined unscanned as a
# releasable "oversize" withhold. Invalid or non-positive values refuse to
# start. There is NO screening off-switch: disabling the control is a code
# change that travels through review (AGENTS.md §5).
ATB_SCREEN_MAX_BYTES=

# Per-blob quarantine cap in bytes (default 16777216 = 16 MiB). Beyond it:
# withheld, nothing hashed or stored, no release path.
ATB_QUARANTINE_MAX_BYTES=

# Aggregate quarantine budget in bytes (default 268435456 = 256 MiB). A put
# beyond it fails closed as quarantine_unavailable until the operator purges
# resolved blobs (atb quarantine purge).
ATB_QUARANTINE_BUDGET_BYTES=

# --- ATB-05 audit-chain lifecycle -------------------------------------------

# Optional HMAC key (hex, >= 32 bytes) sealing the lifecycle records that
# authorize rotation, checkpointing, and archive detachment. DEDICATED — never
# reuse ATB_SIGNING_KEY. Generate: python -c "import secrets; print(secrets.token_hex(32))"
# Unset: lifecycle records are unsealed and an attacker with volume write can
# forge a rotation (documented residual). Set: `atb verify` demands valid tags,
# and a keyed chain verified without the key fails unless --allow-unkeyed.
# Rotation is NEVER automatic: it is the human-run `atb rotate --execute`,
# performed with the gateway stopped. Archived segments are named
# <stem>.seg-NNNNNN.jsonl beside the active chain, become read-only, and are
# committed by whole-file sha256 in their successor's checkpoint.
ATB_CHAIN_SEAL_KEY=
